{
  "name": "@semsig13/tdoc-footer",
  "version": "1.0.0",
  "description": "Custom footer plugin for Quartz",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@jackyzha0/quartz": "*",
    "preact": "^10.0.0"
  },
  "devDependencies": {
    "@jackyzha0/quartz": "^5.0.0",
    "@types/node": "^22.0.0",
    "preact": "^10.22.0",
    "tsup": "^8.5.1",
    "typescript": "^5.6.0"
  }
}